# =============================================================================
# Flashcards — environment template
# =============================================================================
# Copy to `.env.local` for local dev. Production values live in Vercel.
# Every variable validated by `lib/env.ts` (Zod schema).
# NEVER commit `.env.local` — `.gitignore` excludes `.env*`.
# =============================================================================

# --- Supabase (Plan 1.6 wires the clients; Plans 1.7-1.9 add migrations + types refresh) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose as NEXT_PUBLIC_*. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=

# --- Sentry (Plan 1.7) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Domain ---
NEXT_PUBLIC_ROOT_DOMAIN=flashcards.com.br
NEXT_PUBLIC_APP_URL=https://flashcards.com.br

# --- Asaas payments (Plan 4.x) ---
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Email (Plan 4.x — transactional email via Resend) ---
RESEND_API_KEY=

# --- Logging (Plan 1.7 — pino) ---
LOG_LEVEL=info
